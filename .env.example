# 本地运行
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# auto | sqlite | postgres（auto：非 production 用 sqlite，production 用 postgres）
DB_DIALECT=auto
SQLITE_DB_URL=./.data/db.sqlite3

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 生产环境请务必替换为强密码
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=app

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
